---
import Link from '@/shared/components/ui/Link.astro';
import GithubIcon from '@/icons/github.svg';
import LinkedInIcon from '@/icons/linkedin.svg';
import MailIcon from '@/icons/mail.svg';
---

<div class="flex gap-4 dark:text-neutral-200">
  <Link
    href="mailto:info@longville-software.be?subject=Mail from Longville-Software.be"
    icon
    title="Contact me"
  >
    <MailIcon />
  </Link>

  <Link
    href="https://www.linkedin.com/in/hansbrems"
    external
    icon
    title="Linked-In"
  >
    <LinkedInIcon />
  </Link>

  <Link href="https://github.com/HansBrems" external icon title="Github">
    <GithubIcon />
  </Link>
</div>
