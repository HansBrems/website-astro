---
import Prose from '../shared/components/layout/Prose.astro';
import Project from '../features/projects/Project.tsx';
import Page from '../layouts/Page.astro';
import { getCollection } from 'astro:content';
import Link from '../shared/components/ui/Link.astro';

const projects = (await getCollection('projects')).map((x) => x.data);
const categories = (await getCollection('categories')).map((x) => x.data);
---

<Page pageTitle="Home">
  <Prose>
    <div class="grid grid-cols-1 gap-4">
      <section>
        <h1>About Me</h1>

        <p>
          I'm Hans, a freelance software developer from Begijnendijk, Belgium. I
          help companies build <b>applications</b> and <b>services</b> that
          empower users and streamline business processes. I specialize in{' '}
          <b>C#</b> and <b>ASP.NET</b> on the back end, combined with{' '}
          <b>Blazor</b>, <b>Angular</b> or <b>React</b> on the front end. I
          value clean architecture and well-tested code, keeping solutions
          simple so they stay easy to maintain and intuitive to use.
        </p>
      </section>

      <section>
        <h1>Recent Projects</h1>

        <div class="not-prose flex flex-col gap-8">
          {projects.slice(0, 3).map((project) => (
            <Project categories={categories} project={project} client:visible />
          ))}
        </div>

        <div class="mt-4 text-center">
          <Link href="/projects">See more projects</Link>
        </div>
      </section>
    </div>
  </Prose>
</Page>
